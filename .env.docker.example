# Copy to .env.docker; this is separate from your existing native-development .env.
# Generate a signing secret with: docker run --rm python:3.14-slim-bookworm python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required, at least 32 characters; never commit your generated value.
JWT_SECRET=
# Application port on localhost; the database has no published host port.
APP_PORT=8000
