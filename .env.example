# Copy to .env and replace YOUR_PASSWORD with your local PostgreSQL role password.
# The application and Alembic use DATABASE_URL.
DATABASE_URL=postgresql+psycopg://venuepass_user:YOUR_PASSWORD@localhost:5432/venuepass_db
# Integration tests explicitly select this separate database.
TEST_DATABASE_URL=postgresql+psycopg://venuepass_user:YOUR_PASSWORD@localhost:5432/venuepass_db_test

# Replace with a randomly generated signing key of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SIGNING_SECRET
